# -----------------------------------------------------------------------------
# PsySim — plantilla de variables de entorno
# Copia este archivo como .env.local (nunca lo subas al repositorio) o ejecuta
# `vercel env pull .env.local` para descargarlas del proyecto en Vercel.
# -----------------------------------------------------------------------------

# Supabase → Project Settings → API Keys
# URL del proyecto (pública).
NEXT_PUBLIC_SUPABASE_URL=
# Clave publicable `sb_publishable_...` (sustituye a la antigua ANON_KEY). Segura en el
# navegador porque todas las consultas pasan por las políticas RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave secreta `sb_secret_...` (sustituye a la antigua SERVICE_ROLE_KEY). SOLO servidor:
# omite RLS. Nunca la expongas con el prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Inteligencia artificial — Google Gemini (https://aistudio.google.com/apikey)
AI_API_KEY=
# Modelo de Gemini. Por defecto: gemini-3.5-flash
AI_MODEL=gemini-3.5-flash
# Modelo de respaldo si el principal tarda más de 12 s o está saturado (opcional).
# Por defecto: gemini-3.5-flash-lite. Usa `ninguno` para desactivarlo.
# AI_MODEL_RESPALDO=gemini-3.5-flash-lite
# Aleatoriedad (0–2, por defecto 0.8) y tope de tokens por respuesta (por defecto 300).
# AI_TEMPERATURE=0.8
# AI_MAX_TOKENS=300

# Origen de los modelos 3D (opcional). Por defecto se usa el bucket público `modelos-3d` de
# Supabase Storage. Solo cámbialo para probar con otro origen (debe empezar por / o https://).
# NEXT_PUBLIC_MODELOS_BASE_URL=

# -----------------------------------------------------------------------------
# Solo para desarrollo / pruebas (no se configuran en Vercel)
# -----------------------------------------------------------------------------
# Token personal de Supabase para la CLI (migraciones, tipos): supabase.com/dashboard/account/tokens
# SUPABASE_ACCESS_TOKEN=
# Credenciales de un docente de prueba para los tests E2E autenticados
# E2E_DOCENTE_CORREO=
# E2E_DOCENTE_CONTRASENA=
# URL contra la que corren los tests E2E (por defecto, el servidor local)
# PLAYWRIGHT_BASE_URL=
# Secreto "Protection Bypass for Automation" de Vercel, para E2E contra previews protegidos
# VERCEL_AUTOMATION_BYPASS_SECRET=
